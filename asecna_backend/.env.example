# Variables d'environnement — copier ce fichier en .env et remplir les valeurs

# Django
SECRET_KEY=your-very-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DB_NAME=asecna_dev
DB_USER=postgres
DB_PASSWORD=your_password
