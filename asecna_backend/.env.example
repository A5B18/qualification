# Variables d'environnement — copier ce fichier en .env et remplir les valeurs.
#
# DEBUG n'y figure pas : il est porté par le module de settings choisi
# (`config.settings.development` ou `config.settings.production`), et non par
# une variable, afin qu'un .env mal copié ne puisse pas activer DEBUG en
# production.

# ── Django ───────────────────────────────────────────────────────────────────
# Obligatoire en production (le démarrage échoue si elle manque).
# Générer avec : python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=your-very-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Base de données ──────────────────────────────────────────────────────────
# En développement, laisser USE_POSTGRES vide pour utiliser SQLite sans
# configuration. Le poser à True active la configuration PostgreSQL ci-dessous
# (c'est ce que fait docker-compose).
USE_POSTGRES=False
DB_NAME=asecna_dev
DB_USER=postgres
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=5432

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ── Limitation de débit (core.throttling) ────────────────────────────────────
THROTTLE_LOGIN=10/min
THROTTLE_PASSWORD_CHANGE=5/min

# ── Journalisation ───────────────────────────────────────────────────────────
# True pour imprimer chaque requête SQL dans la console (développement).
LOG_SQL=False

# ── Production uniquement ────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://asecna.example.org
CSRF_TRUSTED_ORIGINS=https://asecna.example.org
EMAIL_HOST=smtp.example.org
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@asecna.org
